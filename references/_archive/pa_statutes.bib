  title        = {Act 32 of 2008},
  year         = {2008},
  howpublished = {Pennsylvania Consolidated Statutes},
  note         = {Effective January 1, 2012. Amends 53 P.S. \S\ 6924 to consolidate Earned Income Tax collection into approximately 67 county-based Tax Collection Districts, each with a single appointed collector; mandates standardized employer withholding at the higher of the employee's resident and work-location nonresident rates (the piecewise max-rule). Excludes Philadelphia, which operates under the Sterling Act.},
