  year = 2024,
  month = feb,
  journal = {American Economic Journal: Economic Policy},
  volume = {16},
  number = {1},
  pages = {447--481},
  issn = {1945-7731, 1945-774X},
  doi = {10.1257/pol.20210567},
  urldate = {2026-05-11},
  abstract = {Prior studies show that taxes matter for the residential locations of high-income earners. But states raise a significant share of revenue from nonresidents. Using variation in state tax rates, we provide causal evidence on the effect of the net-of-tax rate on the location of labor supply for professional golfers. State taxes induce high-income earners to shift employment to low-tax states without a residence change. The elasticity of working in a state is 0.34 and, consistent with the superstar phenomenon, increases with earnings. Our results suggest a novel margin of mobility responses for top earners: the spatial relocation of labor supply by nonresidents. (JEL H71, H73, J22, J44, J61, R23, Z22)},
  langid = {english}
}

