@article{landivarAreStatesCreated2021,
  title = {Are {{States Created Equal}}? {{Moving}} to a {{State With More Expensive Childcare Reduces Mothers}}' {{Odds}} of {{Employment}}},
  shorttitle = {Are {{States Created Equal}}?},
  author = {Landivar, Liana Christin and Ruppanner, Leah and Scarborough, William J.},
