  publisher = {Social Science Research Network},
  address = {Rochester, NY},
  doi = {10.2139/ssrn.4736857},
  urldate = {2025-06-02},
  abstract = {We propose a spatial extension of the Synthetic Difference-in-Differences (SyDiD) estimator of Arkhangelsky et al. (2021). Our estimator handles the situation of a possible violation of the Stable Unit Treatment Value Assumption (SUTVA) when treatment may spillover to control units included in the donor pool, resulting in biased and inconsistent Average Treatment Effect (ATE) estimation. We build on the approach of the Spatial Difference-in-Differences estimator of Delgado and Florax (2015) and incorporate it into SyDiD. Thus, the ATE can be disentangled into direct and indirect treatment effects. We compare our approach with both estimators in situations where they would be commonly used. We show that it can be superior to Spatial Difference-in-Differences when estimating the indirect effect. Simultaneously, it still preserves the favorable properties of Synthetic Difference-in-Differences if estimating the direct effect.},
  archiveprefix = {Social Science Research Network},
  langid = {english},
  keywords = {Average Treatment Effect,Difference-in-Differences,Spatial Econometrics,Stable Unit Treatment Value Assumption,Synthetic Control,Treatment Spillovers},
