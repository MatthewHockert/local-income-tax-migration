}

@article{agrawalLocalPolicyChoice2022,
  title = {Local {{Policy Choice}}: {{Theory}} and {{Empirics}}},
  shorttitle = {Local {{Policy Choice}}},
  author = {Agrawal, David R. and Hoyt, William H. and Wilson, John D.},
  year = 2022,
  month = dec,
  journal = {Journal of Economic Literature},
  volume = {60},
  number = {4},
  pages = {1378--1455},
  issn = {0022-0515},
  doi = {10.1257/jel.20201490},
  urldate = {2026-05-07},
  abstract = {This paper critically surveys the growing literature on the policy choices of local governments. First, we identify various reasons for local government policy interactions, including fiscal competition, bidding for firms, yardstick competition, expenditure spillovers, and Tiebout sorting. We discuss theoretically what parameters should be estimated to determine the reason for competition among local governments. We emphasize how the policy outcomes emerging from this competition are affected by the presence of constraints imposed by higher-level governments. Second, we integrate theoretical and empirical analyses on the effects of fiscal decentralization on mobility, spillovers, fiscal externalities, economic outcomes, and distributional issues. Third, we identify key issues that arise in the empirical estimation of strategic interactions among local governments and highlight recent quasi-experimental evidence that has attempted to identify the mechanism at work. Finally, a synthesis model, containing multiple mechanisms and fiscal instruments, resolves some puzzles and provides guidance for future research. (JEL D72,H20, H71, H72, H73, H77, R51)},
  langid = {english},
  keywords = {tier2,to read},
  file = {/Users/matthewhockert/Zotero/storage/456KK2CM/Agrawal et al. - 2022 - Local Policy Choice Theory and Empirics.pdf}
}

